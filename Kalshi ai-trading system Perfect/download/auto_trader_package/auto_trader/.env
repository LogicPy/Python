DATABASE_URL=file:/home/z/my-project/db/custom.db

# ╔══════════════════════════════════════════════════════════════╗
# ║  KALSHI CRYPTO SCALPER — Configuration                     ║
# ║  Late-Game Momentum Scalping Bot                            ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Kalshi API Credentials ──────────────────────────────────────
KALSHI_API_KEY=Your_API_Key
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Kalshi Environment:
#   "demo" — Uses demo-api.kalshi.co (sandbox, no real money)
#   "prod" — Uses api.elections.kalshi.com (live market data)
# NOTE: Your API key is a PRODUCTION key (verified working)
KALSHI_ENV=prod

# ── Binance API ─────────────────────────────────────────────────
# US users MUST use api.binance.us (api.binance.com returns HTTP 451)
BINANCE_BASE_URL=https://api.binance.us
BINANCE_API_KEY=Your_API_Key
BINANCE_API_SECRET=Your_API_Secret

# ── OpenRouter API (for AI-enhanced analysis) ──────────────────
OPENROUTER_API_KEY=Your_API_Key
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# ── Trading Configuration ──────────────────────────────────────
# Paper mode (true = simulation, false = real money)
PAPER_TRADING=true

# Position sizing
MAX_POSITION_SIZE_DOLLARS=2.00
MAX_DAILY_LOSS_DOLLARS=15.00

# ── Aggressive Scalping Settings ───────────────────────────────
# Momentum threshold: 0.03% is VERY sensitive (catches tiny moves)
# Old 0.15% was too strict — almost never triggered
MIN_MOMENTUM_PCT=0.03

# Aggression level:
#   "conservative" — only STRONG/MODERATE signals
#   "aggressive"   — trade WEAK+ signals (RECOMMENDED for scalping)
#   "hyper"        — trade ANY directional signal (maximum frequency)
AGGRESSION=aggressive

# Trade ALL symbols with signals, not just the best one
TRADE_ALL_SIGNALS=true

# Minimum confidence to execute (0.20 = very aggressive)
MIN_CONFIDENCE=0.20

# Entry window: T-8 minutes (more data = better signals)
ENTRY_WINDOW_MINUTES=8

# Risk controls
COOLDOWN_AFTER_LOSS=true
COOLDOWN_WINDOWS=1

# Which cryptos to watch (comma-separated)
ACTIVE_SYMBOLS=ETH,XRP,SOL,DOGE

# ╔══════════════════════════════════════════════════════════════╗
# ║  WEATHER TRADING SYSTEM — Configuration                     ║
# ║  AI-Enhanced Auto-Trading for Kalshi Climate Markets        ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Weather Trading Settings ─────────────────────────────────
# How often to scan for weather market opportunities (minutes)
WEATHER_SCAN_INTERVAL=30

# Max concurrent weather positions
MAX_WEATHER_POSITIONS=5

# Max dollar amount per weather trade
MAX_WEATHER_POSITION_DOLLARS=5.00

# Minimum EV edge to enter a weather trade (cents)
WEATHER_MIN_EV_CENTS=10

# Minimum confidence to enter a weather trade (0-1)
WEATHER_MIN_CONFIDENCE=0.55

# Auto-execute weather trades (false = scan/analyze only, true = execute)
WEATHER_AUTO_TRADE=false

# Use AI to enhance weather trade analysis
WEATHER_AI_ENHANCED=true

# ── Strategy Settings ─────────────────────────────────────────
# Minimum EV edge threshold for all strategies (cents)
MIN_EV_THRESHOLD_CENTS=10

# Position sizing for EV-based strategies
BASE_POSITION_SIZE=5
STRATEGY_MAX_POSITION_SIZE=25

# ── Strategy Toggles ──────────────────────────────────────────
ENABLE_WEATHER=true
ENABLE_POLITICS=true
ENABLE_ECONOMICS=true
ENABLE_SPORTS=false
ENABLE_CRYPTO=true

# ── Dynamic Category Adjustment ───────────────────────────────
# How often to re-evaluate category priorities (minutes)
CATEGORY_ROTATION_INTERVAL=60

# Auto-disable category after N empty scans
AUTO_DISABLE_AFTER_EMPTY_SCANS=5

# Re-enable disabled category after N minutes
AUTO_REENABLE_AFTER_MINUTES=120

# ── OpenRouter Model ──────────────────────────────────────────
OPENROUTER_MODEL=z-ai/glm-5.1

# ╔══════════════════════════════════════════════════════════════╗
# ║  TRADING MODE — Scalper vs Quantitative Probability         ║
# ╚══════════════════════════════════════════════════════════════╝

# Trading Mode:
#   "scalper"          — Trade on ANY momentum, frequent small wins (default)
#   "quant_probability" — Only >60% prob trades, +EV focus, Safe-Bet chains
TRADING_MODE=scalper

# ── Quantitative Probability Mode Settings ─────────────────────
# Only used when TRADING_MODE=quant_probability

# Minimum win probability to enter a trade (0.60 = 60%)
QUANT_MIN_WIN_PROBABILITY=0.60

# Minimum EV edge in cents (15 = market must be mispriced by 15c+)
QUANT_MIN_EV_EDGE_CENTS=15.0

# Minimum confidence in our fair value estimate (0.60 = 60%)
QUANT_MIN_CONFIDENCE=0.60

# Compound threshold: edge * confidence must exceed this
QUANT_COMPOUND_THRESHOLD=0.10

# Max concurrent "Safe-Bet" chain positions
QUANT_MAX_SAFE_BET_CHAINS=3

# Mispricing detection threshold
QUANT_MISPRICING_THRESHOLD=0.08

# Direction consistency minimum for crypto signals
QUANT_DIRECTION_CONSISTENCY_MIN=0.70

# Position scaling for high conviction (1.5x at 75% conf, 2x at 85% conf)
QUANT_POSITION_SCALE_HIGH_CONV=1.5
QUANT_POSITION_SCALE_VERY_HIGH_CONV=2.0
QUANT_HIGH_CONV_THRESHOLD=0.75
QUANT_VERY_HIGH_CONV_THRESHOLD=0.85

# Master switch for quant mode
QUANT_MODE_ENABLED=true
